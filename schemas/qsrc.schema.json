{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/superrep2/qsrc-control-plane/schemas/qsrc.schema.json",
  "title": "QSRC ledger",
  "type": "object",
  "required": ["created", "mode", "approvals", "events"],
  "properties": {
    "created": { "type": "string" },
    "mode": { "enum": ["HOLD", "DRAFT", "MUTATE"] },
    "approvals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": { "enum": ["approve", "deny", "pending"] },
          "note": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "ev"],
        "properties": {
          "t": { "type": "string" },
          "ev": { "type": "string" }
        }
      }
    }
  }
}
